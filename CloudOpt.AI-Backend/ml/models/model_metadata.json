{
  "model_type": "RandomForestClassifier",
  "features": [
    "cpu_usage",
    "memory_usage",
    "net_io",
    "disk_io",
    "vCPU",
    "RAM_GB",
    "price_per_hour",
    "latency_ms",
    "throughput",
    "cost",
    "utilization"
  ],
  "target": "target",
  "classes": [
    "no_action",
    "scale_down",
    "scale_up"
  ],
  "metrics": {
